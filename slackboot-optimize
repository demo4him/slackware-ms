sudo cp -p /usr/local/sbin/slackboot-optimize \
  /usr/local/sbin/slackboot-optimize.old 2>/dev/null || true

sudo sh -c 'cat > /usr/local/sbin/slackboot-optimize' <<'"'"'EOF'"'"'
#!/bin/sh
#
# slackboot-optimize
#
# Slackware 15.0 - conservative boot parallelization
#
# Parallelizes only independently verified leaf services.
# Does NOT use systemd, ionice, service scanners, or generic rc.d runners.
#

PATH=/sbin:/usr/sbin:/bin:/usr/bin

RCM=/etc/rc.d/rc.M
RCINET2=/etc/rc.d/rc.inet2
BACKUP_DIR=/var/backups/slackboot-optimize

die()
{
    echo "ERROR: $*" >&2
    exit 1
}

need_root()
{
    [ "$(id -u)" = 0 ] || die "Run this script as root."
}

backup_file()
{
    file="$1"
    stamp="$2"

    [ -f "$file" ] || die "Missing file: $file"

    cp -p "$file" "$BACKUP_DIR/$(basename "$file").$stamp" ||
        die "Cannot backup $file"
}

check_file()
{
    file="$1"

    [ -f "$file" ] || die "Missing file: $file"

    echo "Checking syntax: $file"

    sh -n "$file" ||
        die "Syntax check FAILED: $file"

    echo "OK: $file"
}

check_all()
{
    check_file "$RCM"
    check_file "$RCINET2"

    echo
    echo "Syntax check: OK"
}

#
# Replace one exact line while preserving the original file mode.
#
replace_line()
{
    file="$1"
    old="$2"
    new="$3"

    tmp="${file}.slackboot.$$"

    awk -v old="$old" -v new="$new" '
        $0 == old {
            print new
            found++
            next
        }
        { print }
        END {
            if (found > 1)
                exit 2
        }
    ' "$file" > "$tmp"

    rc=$?

    if [ "$rc" -eq 2 ]; then
        rm -f "$tmp"
        die "Ambiguous match in $file:
  $old"
    fi

    if [ "$rc" -ne 0 ]; then
        rm -f "$tmp"
        die "Could not process $file"
    fi

    if cmp -s "$file" "$tmp"; then
        rm -f "$tmp"
        return 0
    fi

    mode="$(stat -c '%a' "$file")" ||
        {
            rm -f "$tmp"
            die "Cannot determine permissions of $file"
        }

    chmod "$mode" "$tmp" ||
        {
            rm -f "$tmp"
            die "Cannot preserve permissions of $file"
        }

    mv "$tmp" "$file" ||
        {
            rm -f "$tmp"
            die "Cannot replace $file"
        }
}

#
# Return success when all intended optimizations
# are already present.
#
already_optimized()
{
    grep -Fqx '  /etc/rc.d/rc.inetd start &' "$RCINET2" &&
    grep -Fqx '  /etc/rc.d/rc.sshd start &' "$RCINET2" &&
    grep -Fqx '  /etc/rc.d/rc.bind start &' "$RCINET2" &&
    grep -Fqx '  /etc/rc.d/rc.acpid start &' "$RCM" &&
    grep -Fqx '  /etc/rc.d/rc.cups start &' "$RCM" &&
    grep -Fqx '  /etc/rc.d/rc.crond start &' "$RCM" &&
    grep -Fqx '  /etc/rc.d/rc.atd start &' "$RCM" &&
    grep -Fqx '  /etc/rc.d/rc.postfix start &' "$RCM" &&
    grep -Fqx '  /etc/rc.d/rc.gpm start &' "$RCM"
}

apply_changes()
{
    need_root

    [ -f "$RCM" ] ||
        die "Missing file: $RCM"

    [ -f "$RCINET2" ] ||
        die "Missing file: $RCINET2"

    check_all

    if already_optimized; then
        echo
        echo "=========================================="
        echo " slackboot-optimize: ALREADY OPTIMIZED"
        echo "=========================================="
        echo
        echo "No changes made."
        echo "No new backup created."
        echo
        return 0
    fi

    mkdir -p "$BACKUP_DIR" ||
        die "Cannot create $BACKUP_DIR"

    stamp="$(date '+%Y%m%d-%H%M%S')"

    echo
    echo "Creating backups..."

    backup_file "$RCM" "$stamp"
    backup_file "$RCINET2" "$stamp"

    echo
    echo "Optimizing rc.inet2..."

    #
    # Individually verified leaf services:
    # rc.inetd, rc.sshd, rc.bind
    #

    replace_line "$RCINET2" \
        '  /etc/rc.d/rc.inetd start' \
        '  /etc/rc.d/rc.inetd start &'

    replace_line "$RCINET2" \
        '  /etc/rc.d/rc.sshd start' \
        '  /etc/rc.d/rc.sshd start &'

    replace_line "$RCINET2" \
        '  /etc/rc.d/rc.bind start' \
        '  /etc/rc.d/rc.bind start &'

    echo
    echo "Optimizing rc.M..."

    #
    # Individually verified leaf services:
    # acpid, cups, crond, atd, postfix, gpm
    #

    replace_line "$RCM" \
        '  /etc/rc.d/rc.acpid start' \
        '  /etc/rc.d/rc.acpid start &'

    replace_line "$RCM" \
        '  /etc/rc.d/rc.cups start' \
        '  /etc/rc.d/rc.cups start &'

    replace_line "$RCM" \
        '  /etc/rc.d/rc.crond start' \
        '  /etc/rc.d/rc.crond start &'

    replace_line "$RCM" \
        '  /etc/rc.d/rc.atd start' \
        '  /etc/rc.d/rc.atd start &'

    replace_line "$RCM" \
        '  /etc/rc.d/rc.postfix start' \
        '  /etc/rc.d/rc.postfix start &'

    replace_line "$RCM" \
        '  /etc/rc.d/rc.gpm start' \
        '  /etc/rc.d/rc.gpm start &'

    #
    # rc.smartd is deliberately NOT modified.
    # smartd already backgrounds itself internally.
    #

    echo
    echo "Checking modified files..."

    check_all

    echo
    echo "=========================================="
    echo " slackboot-optimize: APPLY SUCCESSFUL"
    echo "=========================================="
    echo
    echo "Backup:"
    echo "  $BACKUP_DIR/*.$stamp"
    echo
    echo "Optimized services:"
    echo "  rc.inet2: inetd sshd bind"
    echo "  rc.M:     acpid cups crond atd postfix gpm"
    echo
    echo "smartd: unchanged (already asynchronous)"
    echo
    echo "Reboot and verify with:"
    echo
    echo "  ps -eo pid,ppid,comm,args --sort=pid | grep -E '[s]martd|[/](inetd|sshd|named|acpid|cupsd|crond|atd|gpm|postfix)'"
    echo
}

status()
{
    echo "===== slackboot-optimize status ====="
    echo

    echo "rc.M:"
    grep -nE \
        'rc\.(acpid|cups|crond|atd|postfix|gpm) start' \
        "$RCM" 2>/dev/null

    echo

    echo "rc.inet2:"
    grep -nE \
        'rc\.(inetd|sshd|bind) start' \
        "$RCINET2" 2>/dev/null

    echo

    echo "Backups:"
    if [ -d "$BACKUP_DIR" ]; then
        ls -1t "$BACKUP_DIR" 2>/dev/null
    else
        echo "  none"
    fi
}

backup()
{
    need_root

    mkdir -p "$BACKUP_DIR" ||
        die "Cannot create $BACKUP_DIR"

    stamp="$(date '+%Y%m%d-%H%M%S')"

    backup_file "$RCM" "$stamp"
    backup_file "$RCINET2" "$stamp"

    echo
    echo "Backup created:"
    echo "  $BACKUP_DIR/rc.M.$stamp"
    echo "  $BACKUP_DIR/rc.inet2.$stamp"
}

#
# Find the newest backup timestamp for which BOTH
# rc.M and rc.inet2 exist.
#
find_latest_pair()
{
    base_m="$(basename "$RCM")"
    base_i="$(basename "$RCINET2")"

    for latest_m in $(ls -1t "$BACKUP_DIR/$base_m".* 2>/dev/null); do
        stamp="${latest_m##*.}"

        if [ -f "$BACKUP_DIR/$base_i.$stamp" ]; then
            LATEST_STAMP="$stamp"
            return 0
        fi
    done

    return 1
}

rollback()
{
    need_root

    [ -d "$BACKUP_DIR" ] ||
        die "No backup directory found: $BACKUP_DIR"

    find_latest_pair ||
        die "No complete backup pair found."

    backup_m="$BACKUP_DIR/$(basename "$RCM").$LATEST_STAMP"
    backup_i="$BACKUP_DIR/$(basename "$RCINET2").$LATEST_STAMP"

    echo "Rolling back latest complete backup pair..."
    echo
    echo "Backup timestamp:"
    echo "  $LATEST_STAMP"
    echo
    echo "Restoring:"
    echo "  $backup_m"
    echo "  -> $RCM"
    echo "  $backup_i"
    echo "  -> $RCINET2"

    cp -p "$backup_m" "$RCM" ||
        die "Cannot restore $RCM"

    cp -p "$backup_i" "$RCINET2" ||
        die "Cannot restore $RCINET2"

    echo
    echo "Checking restored files..."

    check_all

    echo
    echo "=========================================="
    echo " slackboot-optimize: ROLLBACK SUCCESSFUL"
    echo "=========================================="
    echo
    echo "Reboot recommended."
}

usage()
{
    echo "Usage: $0 {check|status|backup|apply|rollback}"
    echo
    echo "  check     Check rc.M and rc.inet2 syntax"
    echo "  status    Show current parallelized services"
    echo "  backup    Create manual backup"
    echo "  apply     Apply conservative boot optimization"
    echo "  rollback  Restore latest complete backup pair"
}

case "$1" in
    check)
        check_all
        ;;
    status)
        status
        ;;
    backup)
        backup
        ;;
    apply)
        apply_changes
        ;;
    rollback)
        rollback
        ;;
    *)
        usage
        exit 1
        ;;
esac

exit 0
EOF

chmod 755 /usr/local/sbin/slackboot-optimize
'

echo
echo "===== syntax check ====="
sudo sh -n /usr/local/sbin/slackboot-optimize &&
echo "OK: syntax"

echo
echo "===== installed ====="
ls -l /usr/local/sbin/slackboot-optimize

echo
echo "===== status ====="
sudo /usr/local/sbin/slackboot-optimize status