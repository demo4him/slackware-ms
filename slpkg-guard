cat << 'EOF' > /tmp/slpkg-guard.sh
#!/bin/sh
# ---------------------------------------------------------------------
# Name: slpkg-guard.sh
# Description: Production guard for slpkg. Purges local config files
#              and downloads the official variants from Marius's GitHub.
# Author: Marius & AI Collaborator
# ---------------------------------------------------------------------

set -eu

RC='\033[0m'
VERDE='\033[0;32m'
GALBEN='\033[0;33m'
ALBASTRU='\033[0;34m'
ROSU='\033[0;31m'

# Auto-escalate privileges via sudo NOPASSWD
if [ "$(id -u)" -ne 0 ]; then
   if [ -f "$0" ] && [ ! -x "$0" ]; then chmod +x "$0"; fi
   if command -v sudo >/dev/null 2>&1; then 
       exec sudo -H "$0" "$@"
   else 
       exit 1
   fi
fi

CONF_DIR="/etc/slpkg"
REPO_URL="https://github.com/demo4him/slackware-ms/raw/refs/heads/main/repositories.toml"
CONF_URL="https://github.com/demo4him/slackware-ms/raw/refs/heads/main/slpkg.toml"

FETCH_CMD=""
if command -v curl >/dev/null 2>&1; then
    FETCH_CMD="curl -sSL -o"
elif command -v wget >/dev/null 2>&1; then
    FETCH_CMD="wget -q -O"
else
    printf "%b[-] Error: The script requires curl or wget to function!%b\n" "$ROSU" "$RC" >&2
    exit 1
fi

printf "%b==================================================%b\n" "$ALBASTRU" "$RC"
printf "%b         AUTOMATED GITHUB GUARD FOR SLPKG          %b\n" "$VERDE" "$RC"
printf "%b==================================================%b\n" "$ALBASTRU" "$RC"

# Step 1: Safety backup for current files
printf "%b[>] Generating .orig backup copies...%b\n" "$GALBEN" "$RC"
if [ -f "$CONF_DIR/repositories.toml" ]; then cp "$CONF_DIR/repositories.toml" "$CONF_DIR/repositories.toml.orig"; fi
if [ -f "$CONF_DIR/slpkg.toml" ]; then cp "$CONF_DIR/slpkg.toml" "$CONF_DIR/slpkg.toml.orig"; fi

# Step 2: Purge (Physical deletion) of original files from /etc/slpkg/
printf "%b[>] Deleting original local files for a total cleanup...%b\n" "$ROSU" "$RC"
rm -f "$CONF_DIR/repositories.toml" "$CONF_DIR/slpkg.toml"

# Step 3: Downloading modified variants straight from your GitHub repo
printf "%b[>] Downloading 'repositories.toml' from GitHub repo...%b " "$GALBEN" "$RC"
$FETCH_CMD "$CONF_DIR/repositories.toml" "$REPO_URL"
printf "%b[ DOWNLOADED ]%b\n" "$VERDE" "$RC"

printf "%b[>] Downloading 'slpkg.toml' from GitHub repo...%b        " "$GALBEN" "$RC"
$FETCH_CMD "$CONF_DIR/slpkg.toml" "$CONF_URL"
printf "%b[ DOWNLOADED ]%b\n" "$VERDE" "$RC"

# Set standard secure permissions for configuration files
chmod 644 "$CONF_DIR/repositories.toml" "$CONF_DIR/slpkg.toml"

printf "%b==================================================%b\n" "$ALBASTRU" "$RC"
printf "%b[✔] SUCCESS: Both files have been synchronized perfectly!%b\n" "$VERDE" "$RC"
printf "%b==================================================%b\n" "$ALBASTRU" "$RC"
EOF

sudo mv /tmp/slpkg-guard.sh /usr/local/bin/slpkg-guard
sudo chmod +x /usr/local/bin/slpkg-guard
slpkg-guard
